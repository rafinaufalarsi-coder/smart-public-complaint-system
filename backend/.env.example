# ============================================================================
# SPCS Backend — Konfigurasi Environment
# SALIN file ini menjadi .env dan ISI SEMUA nilai yang ditandai [WAJIB]
# JANGAN pernah commit file .env ke repository!
# ============================================================================

# Server
APP_HOST=127.0.0.1
APP_PORT=8080

# ============================================================================
# [WAJIB] PostgreSQL Connection with PostGIS Extension
# Format: postgres://<username>:<password>@<host>:<port>/<database_name>
# Server AKAN GAGAL START jika DATABASE_URL tidak diset.
# ============================================================================
DATABASE_URL=postgres://spcs_user:GANTI_PASSWORD_INI@localhost:5432/spcs

# ============================================================================
# [WAJIB] JWT Secret Key — KRITIS untuk keamanan autentikasi
# WAJIB diganti dengan nilai acak yang kuat, minimal 32 karakter.
# Server AKAN PANIC dan MENOLAK START jika JWT_SECRET tidak diset
# atau kurang dari 32 karakter.
#
# Cara generate di Linux/macOS:
#   openssl rand -hex 32
# Cara generate di PowerShell (Windows):
#   -join ((1..32) | ForEach-Object { '{0:X2}' -f (Get-Random -Max 256) })
#
# JANGAN gunakan nilai default di bawah ini di lingkungan production!
# ============================================================================
JWT_SECRET=GANTI_DENGAN_NILAI_ACAK_MINIMAL_32_KARAKTER_YANG_KUAT_DAN_UNIK

JWT_EXPIRES_IN_HOURS=12

# ============================================================================
# [WAJIB] Frontend Origin untuk CORS Whitelist
# Hanya origin ini yang diizinkan mengakses API backend.
# Di production, ubah ke domain frontend yang sebenarnya.
# ============================================================================
FRONTEND_ORIGIN=http://localhost:3000

# Tracing dan Logging
RUST_LOG=info,tower_http=info
